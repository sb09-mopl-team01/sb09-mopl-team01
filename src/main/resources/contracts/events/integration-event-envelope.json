{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mopl.io/contracts/events/integration-event-envelope.json",
  "title": "MOPL Integration Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "aggregateType",
    "aggregateId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Outbox row ID. Consumers use it for idempotent processing."
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "eventVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object"
    }
  }
}
